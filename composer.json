{
  "name": "sampoyigi/testbench",
  "require": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
    "pestphp/pest-plugin-phpstan": "^4.0 || ^5.0",
    "pestphp/pest-plugin-rector": "^4.0 || ^5.0",
    "rector/rector": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "SamPoyigi\\Testbench\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
